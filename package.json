{
  "name": "calendar-calculate",
  "version": "2.0.0",
  "description": "A simple function retrieves dates within a specified range that fall on specific weekdays.",
  "type": "module",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abdiel49/calendar-calculate"
  },
  "homepage": "https://github.com/Abdiel49/calendar-calculate#readme",
  "bugs": "https://github.com/Abdiel49/calendar-calculate/issues",
  "scripts": {
    "build-node": "tsc src/index.ts --outDir dist-node --isolatedModules",
    "build-browser": "tsc src/index.ts --outDir dist-browser --module ES6 --isolatedModules",
    "build": "tsc",
    "start:dev": "tsc src/index.ts --watch",
    "start": "npm run build & node dist/index.js",
    "test": "jest --config jest.config.ts --watchAll=false",
    "test:unit": "jest --config jest.config.ts --watchAll=false --testPathPatterns=tests/unit",
    "test:e2e": "jest --config jest.config.ts --watchAll=false --testPathPatterns=tests/e2e",
    "test:coverage": "jest --config jest.config.ts --watchAll=false --coverage"
  },
  "keywords": [
    "calendar",
    "calculate",
    "date",
    "dates"
  ],
  "author": "Abdiel49",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
